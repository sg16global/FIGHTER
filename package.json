{
  "name": "aegis-sovereign-ai-dev-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Aegis AI Dev Studio — Sovereign Mistral Autonomous Dev Workstation",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.34.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "electron": "35.1.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.saiftechglobal.aegis-dev-studio",
    "productName": "Aegis AI Dev Studio",
